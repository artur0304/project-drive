# Локальный список администраторов каталога. Настоящие email и секреты сюда не коммитить.
PROJECT_DRIVE_ADMIN_EMAILS=owner@example.com

# Оставлять выключенным до отдельного решения по платёжному провайдеру.
PROJECT_DRIVE_ENABLE_MOCK_PAYMENTS=0

# AI remains free/local unless this is explicitly changed to live for one run.
PROJECT_DRIVE_AI_MODE=mock
# Server-only fal.ai credential. Never expose it as NEXT_PUBLIC_* or commit .env.
FAL_KEY=
PROJECT_DRIVE_LIFETIME_BUDGET_USD=5
PROJECT_DRIVE_DAILY_BUDGET_USD=2
PROJECT_DRIVE_GENERATIONS_PER_HOUR=6
# Normalized mean RGB difference (0..1). Live calibration is still pending.
PROJECT_DRIVE_MIN_IMAGE_DIFFERENCE=0.012
PROJECT_DRIVE_FAL_TIMEOUT_MS=90000
PROJECT_DRIVE_PENDING_JOB_RECOVERY_MINUTES=10

# Production preparation. LOCAL is the only implemented adapter today.
PROJECT_DRIVE_OBJECT_STORAGE=local
